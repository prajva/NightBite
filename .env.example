# =====================================================================
# NightBite Environment Variables & Configuration
# =====================================================================

# 1. Student University Domain Lock (Strictly restricts student sign-in)
# Personal @gmail.com or other external domains are rejected with a clear error banner.
NEXT_PUBLIC_ALLOWED_DOMAIN="vitapstudent.ac.in"

# 2. Whitelisted Admin Email IDs (Comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS="admin@nightbite.ac.in,messadmin@vitap.ac.in,prajval@nightbite.ac.in"

# 3. Default Strong Admin Credentials (for Counter Staff login)
NEXT_PUBLIC_ADMIN_PASSWORD="NightBite@Admin#2026!"
NEXT_PUBLIC_ADMIN_PASSCODE="8392"

# 4. Firebase Project Credentials (Project: nightbite-e)
# Get these by clicking the Web </> icon in your Firebase Console:
# https://console.firebase.google.com/project/nightbite-e/overview
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="nightbite-e.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="nightbite-e"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="nightbite-e.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
