# =====================================================================
# NightBite Environment Variables & Configuration
# =====================================================================

# 1. Student University Domain Lock (Strictly restricts student sign-in)
# Personal @gmail.com or other external domains are rejected with a clear error banner.
NEXT_PUBLIC_ALLOWED_DOMAIN="vitapstudent.ac.in"

# 2. Whitelisted Admin Email IDs (Comma-separated)
# Grants access to the Mess Counter Admin Dashboard & kitchen controls.
NEXT_PUBLIC_ADMIN_EMAILS="messadmin@vitap.ac.in,admin@nightbite.ac.in"

# 3. Firebase Project Credentials (Optional for local dev / Required for Cloud Firestore sync)
# If not configured, NightBite automatically falls back to the built-in real-time local storage
# and BroadcastChannel engine so the app remains 100% interactive and testable immediately!
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
